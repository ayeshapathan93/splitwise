PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/splitwise
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development

# SMTP account used to send registration, password reset, and invite OTPs
SMTP_HOST=smtp.gmail.com
